# Copie para .env e ajuste os caminhos. O .env nao vai para o git.

# Raiz dos ARTEFATOS (datasets/, training/, models/). Ficam fora do repositorio.
PTBR_ARTIFACTS=C:\caminho\para\artefatos

# Opcionais (tem defaults):
# BREEZE_TTS_REPO=            # engine breeze-tts (default: raiz deste repo)
# BREEZE_CKPT=                # default: <PTBR_ARTIFACTS>/models/Breeze-TTS-2
# BREEZE_DATASETS_DIR=        # default: <PTBR_ARTIFACTS>/datasets
# BREEZE_TRAINING_DIR=        # default: <PTBR_ARTIFACTS>/training
# BREEZE_DATASET_DIR=         # corpus legado unico (default: <datasets>/TTS-Portuguese-Corpus)
# BREEZE_PY=                  # interpretador python (default: sys.executable)

# Chaves usadas apenas pelo pipeline de scraping (nao precisa para treinar):
# XAI_TRANSCRIBE_KEY=
# HF_TOKEN=
